{
  "name": "@ericjdz/arkive",
  "version": "0.2.1",
  "description": "A living architecture document for AI-built projects. Your AI agent maintains it; you understand what was built.",
  "type": "module",
  "license": "MIT",
  "author": "arkive contributors",
  "homepage": "https://github.com/arkive/arkive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkive/arkive.git"
  },
  "bugs": {
    "url": "https://github.com/arkive/arkive/issues"
  },
  "keywords": [
    "architecture",
    "ai",
    "agent",
    "mcp",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "opencode",
    "documentation",
    "system-design",
    "learning"
  ],
  "bin": {
    "arkive": "bin/arkive.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "src/templates",
    ".claude-plugin",
    "CLAUDE.md",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cli": "tsup",
    "build:viewer": "vite build --config src/viewer/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npx tsx scripts/prepublish.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
