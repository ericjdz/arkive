# The viewer is nested inside the main package, so the repo root already provides
# React. Installing the viewer's own React (npm auto-installs it to satisfy
# @xyflow/react's peer dependency) puts two React copies in the module graph and
# breaks hooks at runtime. Skipping peer auto-install means React resolves from
# the root node_modules by normal upward resolution instead.
#
# See architecture decision dec-003 and src/viewer/vite.config.ts, which aliases
# every react import to the root copy for the same reason.
legacy-peer-deps=true